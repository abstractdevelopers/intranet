# Supabase (or any Postgres) — pooled connection for runtime (Supabase pooler, port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=8"
# Direct connection for Prisma Migrate (port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
SESSION_SECRET="change-me"

# Payments — configure one or both providers (leave blank to disable online checkout)
PAYSTACK_SECRET_KEY=
BACHS_KEY=
BACHS_PRODUCT_ID=
BACHS_BASE_URL=https://api.bachs.io

# Email delivery (SendByte) — notifications and password resets are emailed when configured.
# The EMAIL_FROM domain must be verified in the SendByte dashboard.
SENDBYTE_API_KEY=
EMAIL_FROM=UCA Sandbox <no-reply@yourdomain.com>

# Email campaigns — shared secret Vercel Cron sends as a bearer token to
# /api/cron/campaigns. Without it, only a signed-in admin can trigger a run.
CRON_SECRET=

# Web push (browser notifications). Generate with:
#   npx web-push generate-vapid-keys
# The public key is shipped to the browser, so it must be NEXT_PUBLIC_*.
# VAPID_SUBJECT is a mailto: or https: contact for the push service.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@yourdomain.com
